---
// Client's own title card (logo mark + name + tagline), supplied 2026-11-04.
// Originals: docs/brand/sgmc-title-card.pdf and docs/brand/sgmc-logo-mark.jpg.
// Shown on a white plate exactly as supplied, so it reads the same over the dark hero,
// the navy header and the footer — no recolouring of the client's artwork.
import { Picture } from 'astro:assets';
import titleCard from '../assets/brand/sgmc-title-card.png';
interface Props { href?: string; size?: 'header' | 'footer' }
const { href = '/', size = 'header' } = Astro.props;
---
<a href={href} class={`brand brand--${size}`}>
  <Picture
    src={titleCard}
    alt="Shree Gayathri Multi Colour Printers — All Types of Single & Multi Colour Printing"
    formats={['webp']}
    widths={size === 'header' ? [240, 480, 720] : [320, 640, 960]}
    sizes={size === 'header' ? '(max-width: 400px) 170px, 240px' : '320px'}
    loading="eager"
    class="brand__card"
  />
</a>
