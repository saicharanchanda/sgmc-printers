---
/** Gallery of printed work or designs (src/data/work.ts, src/data/design.ts). Each thumbnail opens the full-size image. */
import { Picture, getImage } from 'astro:assets';
import type { WorkSample } from '../data/work';
interface Props { items: WorkSample[]; heading?: string; lead?: string; eyebrow?: string; id?: string; flush?: boolean }
const { items, heading = 'Examples of our work', lead, eyebrow = 'Our work', id = 'work-h', flush = true } = Astro.props;
const full = await Promise.all(items.map((w) => getImage({ src: w.image, width: Math.min(1600, w.image.width), format: 'webp' })));
---
{items.length > 0 && (
  <section class="section" style={flush ? 'padding-top:0' : undefined} aria-labelledby={id}>
    <div class="container">
      <div class="section-head">
        {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
        <h2 id={id} style="margin-top:1rem" data-reveal>{heading}</h2>
        {lead && <p class="lead" data-reveal>{lead}</p>}
      </div>
      <div class="work-grid" data-reveal-stagger>
        {items.map((w, i) => (
          <figure class="work-card" data-reveal>
            <a href={full[i].src} target="_blank" rel="noopener" class="work-card__img" aria-label={`${w.title} — open full size`}>
              <Picture src={w.image} alt={w.alt} formats={['webp']} widths={[400, 700, 1000]} sizes="(min-width: 900px) 40vw, 100vw" loading="lazy" />
              {w.representative && <span class="work-card__tag">Representative image</span>}
            </a>
            <figcaption>
              <strong>{w.title}</strong>
              <span>{w.text}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <slot />
    </div>
  </section>
)}
