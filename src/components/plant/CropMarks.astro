---
// Press-sheet frame: four crop / registration marks that draw in once on scroll.
---
<div class="cropbox" data-crop>
  <i class="crop crop--tl" aria-hidden="true"></i>
  <i class="crop crop--tr" aria-hidden="true"></i>
  <i class="crop crop--bl" aria-hidden="true"></i>
  <i class="crop crop--br" aria-hidden="true"></i>
  <slot />
</div>
