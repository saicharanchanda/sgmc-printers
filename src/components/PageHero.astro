---
/**
 * Inner-page hero: full-bleed dark band with the page's own press photo, the shared
 * background video on desktop (same cached file as the home hero), breadcrumbs and title.
 */
import type { Crumb } from '../layouts/BaseLayout.astro';
import PhotoBg from './PhotoBg.astro';
import HeroVideo from './plant/HeroVideo.astro';
interface Props { eyebrow: string; lines: string[]; lead?: string; crumbs?: Crumb[]; bg?: string[]; bgAlt?: string }
const { eyebrow, lines: rawLines, lead, crumbs = [], bg = ['hero-1'], bgAlt = '' } = Astro.props;
// Single-line titles: last word drops to its own gold line.
const words = rawLines.length === 1 ? rawLines[0].split(' ') : [];
const lines = words.length > 1 ? [words.slice(0, -1).join(' '), words.at(-1)!] : rawLines;
---
<section class="page-hero page-hero--video on-dark">
  <PhotoBg names={bg.slice(0, 1)} alt={bgAlt} overlay="plant" eager />
  <HeroVideo />
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {crumbs.map((c, i) => (
            <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    <p class="eyebrow" style="margin-top:1.6rem">{eyebrow}</p>
    <h1>{lines.map((l, i) => <span class="line"><span set:html={i === lines.length - 1 && lines.length > 1 ? `<em>${l}</em>` : l} /></span>)}</h1>
    {lead && <p class="lead" data-reveal>{lead}</p>}
    <slot />
  </div>
</section>
