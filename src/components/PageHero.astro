---
import type { Crumb } from '../layouts/BaseLayout.astro';
import PhotoBg from './PhotoBg.astro';
import ColorBar from './ColorBar.astro';
interface Props { eyebrow: string; lines: string[]; lead?: string; crumbs?: Crumb[]; bg?: string[]; bgAlt?: string }
const { eyebrow, lines: rawLines, lead, crumbs = [], bg, bgAlt = '' } = Astro.props;
// Single-line titles get the editorial treatment: last word drops to its own italic gold line.
const words = rawLines.length === 1 ? rawLines[0].split(' ') : [];
const lines = words.length > 1 ? [words.slice(0, -1).join(' '), words.at(-1)!] : rawLines;
---
<section class={`page-hero${bg ? ' page-hero--photo on-dark' : ''}`}>
  {bg && <PhotoBg names={bg} alt={bgAlt} eager />}
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {crumbs.map((c, i) => (
            <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    <p class="eyebrow" style="margin-top:1.4rem">{eyebrow}</p>
    <h1>{lines.map((l) => <span class="line"><span set:html={l} /></span>)}</h1>
    {lead && <p class="lead" data-reveal>{lead}</p>}
    <slot />
  </div>
</section>
<ColorBar />
