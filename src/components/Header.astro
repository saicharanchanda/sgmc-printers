---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE, whatsappLink } from '../config/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<div class="progress" aria-hidden="true"></div>
<header class="site-header" data-header>
  <div class="container">
    <Logo />
    <nav class="nav" aria-label="Main">
      {NAV.map((item, i) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}><sup>0{i + 1}</sup>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="header-phone" href={`tel:${SITE.phoneHref}`}><small>Call the press</small><strong>{SITE.phone}</strong></a>
      <a class="btn btn--sm" href="/contact/">Get a quote <Icon name="arrow" class="arrow" /></a>
      <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu" data-menu-toggle>
        <span class="menu-toggle__bars"><span></span><span></span><span></span></span>
        Menu
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu>
  <nav aria-label="Mobile">
    {NAV.map((item, i) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
        <small>0{i + 1}</small>{item.label}
      </a>
    ))}
  </nav>
  <div class="mobile-menu__foot">
    {SITE.contacts.map((c) => <a href={`tel:${c.phoneHref}`}>{c.name} — {c.phone}</a>)}
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <div class="btn-row" style="margin-top:.5rem">
      <a class="btn" href="/contact/">Get a quote</a>
      <a class="btn btn--wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
    </div>
  </div>
</div>
