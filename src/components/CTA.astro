---
import Icon from './Icon.astro';
import { SITE, whatsappLink } from '../config/site';
interface Props { title?: string; text?: string }
const {
  title = 'Have a job for the press?',
  text = 'Send the quantity, size, pages and paper. We’ll come back with a clear quote, usually within a few hours.',
} = Astro.props;
---
<section class="section section--tight">
  <div class="container">
    <div class="cta on-dark" data-reveal>
      <div>
        <p class="eyebrow">Job ticket</p>
        <h2 style="margin-top:1rem">{title}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn" href="/contact/">Get a quote <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--outline" href={`tel:${SITE.phoneHref}`}><Icon name="phone" /> {SITE.phone}</a>
        <a class="btn btn--wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      </div>
    </div>
  </div>
</section>
