---
import Icon from './Icon.astro';
import { NAV, SITE, whatsappLink } from '../config/site';
import { services } from '../data/services';
import { categories } from '../data/products';

const socials = Object.entries(SITE.social).filter(([, url]) => url) as [
  'instagram' | 'facebook' | 'youtube' | 'linkedin',
  string,
][];
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="container">
    <div class="footer-cta">
      <h2>Ready to Bring Your <span class="proof">Project to Life.</span></h2>
      <div class="btn-row">
        <a class="btn" href="/contact/">Request a Printing Quote <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--outline" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      </div>
    </div>

    <div class="footer-top">
      <!-- Left: who we are + every way to reach us -->
      <div class="footer-info">
        <p class="footer-brand">{SITE.legalName}</p>
        <p class="footer-legacy">{SITE.legacyLine}</p>
        <p class="footer-desc">Bringing together generations of printing expertise, integrated production capabilities and a lasting commitment to customer satisfaction.</p>
        <address class="footer-contact">
          <ul>
            {SITE.offices.map((o, i) => (
              <>
                <li>
                  <Icon name="pin" />
                  <a href={o.map} target="_blank" rel="noopener"><strong>{o.label}</strong>{o.lines.join(', ')}</a>
                </li>
                {SITE.contacts[i] && (
                  <li>
                    <Icon name="phone" />
                    <a href={`tel:${SITE.contacts[i].phoneHref}`}>{SITE.contacts[i].phone} <small>({SITE.contacts[i].name})</small></a>
                  </li>
                )}
              </>
            ))}
            <li><Icon name="mail" /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><Icon name="clock" /><span>{SITE.hours.map((h) => <span style="display:block">{h.days}: {h.time}</span>)}</span></li>
          </ul>
        </address>
        {socials.length > 0 && (
          <div class="socials">
            {socials.map(([name, url]) => (
              <a href={url} target="_blank" rel="noopener" aria-label={name}><Icon name={name} /></a>
            ))}
          </div>
        )}
      </div>

      <!-- Right: link columns -->
      <div>
        <h2 class="footer-h">Our Services</h2>
        <ul>{services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}</ul>
      </div>

      <div>
        <h2 class="footer-h">Our Products</h2>
        <ul>{categories.map((c) => <li><a href={`/products/${c.slug}/`}>{c.hub.title}</a></li>)}</ul>
      </div>

      <div>
        <h2 class="footer-h">Quick Links</h2>
        <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </div>
    </div>

    <div class="footer-commit">
      <span class="footer-h">Our Commitment</span>
      <strong>{SITE.promise.join(' • ')}</strong>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.legalName}. All Rights Reserved.</span>
      <span>{SITE.motto}</span>
    </div>
  </div>
</footer>
