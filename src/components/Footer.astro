---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, whatsappLink } from '../config/site';
import { services } from '../data/services';
import { categories } from '../data/products';

const socials = Object.entries(SITE.social).filter(([, url]) => url) as [
  'instagram' | 'facebook' | 'youtube' | 'linkedin',
  string,
][];
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="container">
    <div class="footer-cta">
      <h2>Ready when your <em>files are.</em></h2>
      <div class="btn-row">
        <a class="btn" href="/contact/">Get a quote <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--outline" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      </div>
    </div>

    <div class="footer-top">
      <div class="footer-about">
        <Logo />
        <p>{SITE.legalName}. Books, publications and commercial print on our own offset presses.</p>
        {socials.length > 0 && (
          <div class="socials">
            {socials.map(([name, url]) => (
              <a href={url} target="_blank" rel="noopener" aria-label={name}><Icon name={name} /></a>
            ))}
          </div>
        )}
      </div>

      <div>
        <h2 class="footer-h">Services</h2>
        <ul>{services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}</ul>
      </div>

      <div>
        <h2 class="footer-h">Products</h2>
        <ul>
          {categories.map((c) => <li><a href={`/products/${c.slug}/`}>{c.title.replace(/ Printing$/, '')}</a></li>)}
          <li><a href="/infrastructure/">Infrastructure</a></li>
          <li><a href="/about/">About us</a></li>
        </ul>
      </div>

      <div>
        <h2 class="footer-h">The press</h2>
        <address style="font-style:normal">
          <ul>
            {SITE.offices.map((o) => <li><a href={o.map} target="_blank" rel="noopener"><strong style="display:block">{o.label}</strong>{o.lines.join(', ')}</a></li>)}
            {SITE.contacts.map((c) => <li><a href={`tel:${c.phoneHref}`}>{c.name}: {c.phone}</a></li>)}
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            {SITE.hours.map((h) => <li>{h.days}: {h.time}</li>)}
          </ul>
        </address>
      </div>
    </div>

    <p class="colophon">
      <b>Colophon</b>
      Set in Archivo, Newsreader and JetBrains Mono. Proofed in vermilion, printed in press blue —
      and on paper, by {SITE.legalName}, since {SITE.foundedYear}.
    </p>

    <div class="footer-bottom">
      <span>© {year} {SITE.legalName}</span>
      <span>{SITE.promise.join(' · ')}</span>
    </div>
  </div>
</footer>
