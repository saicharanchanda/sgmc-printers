---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import Leadership from '../components/Leadership.astro';
import { SITE } from '../config/site';

const crumbs = [{ name: 'About', href: '/about/' }];

// Client copy (2026-11-05): the three commitments, explained in the client's own words
const promise = [
  { icon: 'shield', title: 'Quality Printing', text: 'From artwork preparation to final finishing, our production approach emphasizes careful execution and consistency.' },
  { icon: 'rupee', title: 'Competitive Pricing', text: 'We work to provide practical printing solutions and competitive pricing based on your project’s specifications and quantities.' },
  { icon: 'clock', title: 'Timely Delivery', text: 'We understand the importance of production schedules and work closely with customers to plan printing and delivery requirements.' },
] as const;

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: `${SITE.url}/about/`,
  mainEntity: { '@id': `${SITE.url}/#business` },
};
---
<BaseLayout
  heroDark
  title={`About Us — Printing Since ${SITE.foundedYear}`}
  description={`${SITE.legalName}: a family legacy of printing excellence since ${SITE.foundedYear}, serving educational, publication and commercial printing requirements in ${SITE.city}.`}
  breadcrumbs={crumbs}
  schema={[aboutSchema]}
>
  <PageHero
    bg={['bg-about']}
    bgAlt="Offset press in a print shop (illustrative image)"
    eyebrow="About us"
    lines={['Rooted in Tradition.', 'Focused on the Future.']}
    sub={`A Family Legacy of Printing Excellence Since ${SITE.foundedYear}.`}
    lead={`${SITE.legalName} represents generations of printing knowledge, customer relationships and dedication to the craft.`}
    more="What began as a family printing business has continued to develop into an integrated printing operation serving educational, publication and commercial requirements."
    crumbs={crumbs}
  />

  <!-- OUR PHILOSOPHY -->
  <section class="section" aria-labelledby="philosophy-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Our philosophy</p>
          <h2 id="philosophy-h" style="margin-top:1rem" data-reveal>Quality Is Our Commitment. <span class="proof">Trust Is Our Foundation.</span></h2>
        </div>
        <div style="display:grid;gap:1rem">
          <p class="lead" data-reveal>We believe successful printing begins with understanding the customer.</p>
          <p data-reveal>Every project requires the right combination of planning, technical knowledge, equipment and careful execution. Our approach is built around three enduring commitments:</p>
        </div>
      </div>
      <div class="grid grid-3" data-reveal-stagger>
        {promise.map((v) => (
          <div class="card" data-reveal>
            <span class="feature__icon"><Icon name={v.icon} /></span>
            <h3>{v.title}</h3>
            <p class="muted">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR EXPERIENCE -->
  <section class="section section--white">
    <div class="container split">
      <Media name="about-heritage" alt="Vintage printing press (illustrative image)" word={`Est. ${SITE.foundedYear}`} parallax />
      <div style="display:grid;gap:1.4rem">
        <p class="eyebrow" data-reveal>Our experience</p>
        <h2 data-reveal>Decades of Experience. A Continuing Commitment to Progress.</h2>
        {/* NEEDS BUSINESS CONFIRMATION (C-07), before any detailed history is written:
            founder's name, what was printed first and where, dated milestones (first offset press,
            web offset line, CTP, Choutuppal facility) and the number of generations. */}
        <p class="lead" data-reveal>Since {SITE.foundedYear}, we have continued to develop our printing capabilities while preserving the values on which the business was built.</p>
        <p data-reveal>Our experience across educational publications and commercial printing supports a practical understanding of different production requirements.</p>
        <div class="btn-row" data-reveal>
          <a class="btn" href="/infrastructure/">Explore Our Printing Infrastructure <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="stats-h">
    <div class="container">
      <h2 id="stats-h" class="sr-only">SGMC in numbers</h2>
      <div class="stats stats--4" data-reveal style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr))">
        {SITE.stats.map((s) => (
          <div class="stat">
            <strong {...(s.label === 'Printing since' ? {} : { 'data-count': s.value, 'data-suffix': s.suffix })}>{s.value}{s.suffix}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR PEOPLE -->
  <section class="section" aria-labelledby="people-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Our people</p>
          <h2 id="people-h" style="margin-top:1rem" data-reveal>Technology Powers Our Presses. <span class="proof">People Drive Our Excellence.</span></h2>
        </div>
        <div style="display:grid;gap:1rem">
          <p class="lead" data-reveal>Behind our equipment is a team of printing professionals, production personnel, designers and business leaders working together to support customer requirements.</p>
          <p data-reveal>Their combined expertise helps connect every stage of the printing process.</p>
        </div>
      </div>
      <div class="grid grid-3" data-reveal-stagger>
        <div data-reveal><Media name="facility-1" alt="Operator at an offset press (illustrative image)" word="Press" class="zz__media" /></div>
        <div data-reveal><Media name="facility-2" alt="Sheet-fed offset printing machine (illustrative image)" word="Offset" class="zz__media" /></div>
        <div data-reveal><Media name="facility-3" alt="Printed sheets at the press delivery (illustrative image)" word="Output" class="zz__media" /></div>
      </div>
    </div>
  </section>

  <Leadership />

  <CTA
    eyebrow="Work with us"
    title="A Legacy You Can Trust. A Partnership You Can Build On."
    sub=""
    text=""
    primary={{ label: 'Connect With Our Team', href: '/contact/' }}
    secondary={{ label: 'Send Your Requirements', href: '/contact/#enquiry' }}
  />
</BaseLayout>
