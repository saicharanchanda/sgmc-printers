---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
import { SITE, whatsappLink, waMessage } from '../../config/site';
import { categories } from '../../data/products';

const crumbs = [{ name: 'Products', href: '/products/' }];
const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: `${SITE.name} printing products`,
  itemListElement: categories.map((c) => ({
    '@type': 'OfferCatalog',
    name: c.title,
    url: `${SITE.url}/products/${c.slug}/`,
    itemListElement: c.items.map((i) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: `${i} printing` },
      seller: { '@id': `${SITE.url}/#business` },
    })),
  })),
};
---
<BaseLayout
  heroDark
  title={`Printing Products — Textbooks, Magazines & Labels`}
  description={`Printing solutions from educational publications to commercial print: textbooks, notebooks, magazines, journals, annual reports, catalogues, brochures, flyers, posters, labels, manuals, calendars and certificates in ${SITE.city}.`}
  breadcrumbs={crumbs}
  schema={[catalogSchema]}
>
  <PageHero
    bg={['bg-products']}
    bgAlt="Printed books stacked after binding"
    eyebrow="Products"
    lines={['Printing Solutions That', 'Bring Your Ideas to Life.']}
    sub="From Educational Publications to Commercial Print — Crafted With Care."
    lead="Every printed product has a purpose. At SGMC, we combine printing experience, production capabilities and attention to detail to help customers achieve the results they need."
    more="Explore our printing categories and discover the possibilities."
    crumbs={crumbs}
  >
    <nav class="hero-pills" aria-label="Jump to category" data-reveal>
      {categories.map((c) => <a href={`#${c.slug}`} class="btn btn--sm btn--outline">{c.hub.title}</a>)}
    </nav>
  </PageHero>

  <section class="section">
    <div class="container zz">
      {categories.map((c) => (
        <article class="zz__item" id={c.slug}>
          <div data-reveal>
            <Media name={`cat-${c.slug}`} alt={c.title} class="zz__media" word={c.title.split(' ')[0]} parallax />
          </div>
          <div class="zz__body">
            <span class="zz__kicker" data-reveal>{c.hub.tagline}</span>
            <h2 class="h2" data-reveal>{c.hub.title}</h2>
            <p class="lead" data-reveal>{c.hub.text}</p>
            <ul class="item-list" role="list" data-reveal>
              {c.items.map((i) => <li>{i}</li>)}
            </ul>
            <div class="btn-row" data-reveal>
              <a class="btn" href={c.slug === 'printing-options' ? `/contact/?service=${encodeURIComponent(c.title)}` : `/products/${c.slug}/`}>{c.hub.cta} <Icon name="arrow" class="arrow" /></a>
              <a class="btn btn--outline" href={whatsappLink(waMessage(c.title))} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CTA
    eyebrow="Something else?"
    title="Looking for Something Specific?"
    sub=""
    text="Not every printing requirement fits a standard category. Share your specifications with our team and let us help you explore the right solution."
    primary={{ label: 'Enquire About Your Project', href: '/contact/' }}
    secondary={null}
  />
</BaseLayout>
