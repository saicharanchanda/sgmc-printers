---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found" description="The page you are looking for could not be found." noindex>
  <section class="notfound">
    <div class="container" style="display:grid;gap:1.5rem;justify-items:center">
      <div class="notfound__code" aria-hidden="true"><span>4</span><span>0</span><span>4</span></div>
      <h1 class="h2">This page went off-register.</h1>
      <p class="lead" style="margin-inline:auto">The page you’re looking for doesn’t exist or has moved.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn" href="/">Back to home <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--outline" href="/services/">Our services</a>
        <a class="btn btn--outline" href="/products/">Our products</a>
        <a class="btn btn--outline" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
