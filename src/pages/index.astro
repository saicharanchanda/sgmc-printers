---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import PhotoBg from '../components/PhotoBg.astro';
import PhotoTile from '../components/PhotoTile.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import PaperRun from '../components/plant/PaperRun.astro';
import Roller from '../components/plant/Roller.astro';
import TextureBg from '../components/plant/TextureBg.astro';
import CropMarks from '../components/plant/CropMarks.astro';
import HeroVideo from '../components/plant/HeroVideo.astro';
import Leadership from '../components/Leadership.astro';
import { SITE, whatsappLink } from '../config/site';
import { services } from '../data/services';
import { categories } from '../data/products';
import { faqs } from '../data/faqs';

const yr = String(SITE.foundedYear);

// Spec-sheet notes per machine group (facts from docs/client-brief.md)
const groupMeta: Record<string, { code: string; use: string }> = {
  'Web Offset Printing': { code: 'WEB-01', use: 'Reel-fed, high-volume runs: textbooks, notebooks, magazines, periodicals.' },
  'Sheet-Fed Offset Printing': { code: 'SHT-02', use: 'Colour-critical work: covers, brochures, catalogues, posters, short runs.' },
  'Pre-Press': { code: 'PRE-03', use: 'Files checked, imposed and output straight to plate for sharp, accurate print.' },
  'Post-Press & Finishing': { code: 'FIN-04', use: 'Printed sheets become finished books, booklets and notebooks.' },
};

// Client-supplied strengths (docs/client-brief.md §6)
const why = [
  { icon: 'palette', title: 'In-house design team', text: 'Experienced designers for complete artwork development and pre-press support.' },
  { icon: 'press', title: 'Modern machinery', text: 'Multi-colour offset, web printing, CTP and integrated finishing in one building.' },
  { icon: 'clock', title: 'Dependable delivery', text: 'A firm commitment to agreed production schedules and delivery dates.' },
  { icon: 'shield', title: 'Quality at a fair price', text: 'Consistent print quality and competitive pricing, especially for bulk orders.' },
] as const;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  rawTitle
  title={`${SITE.name} | Offset Printing ${SITE.city}`}
  description={`Printing since ${SITE.foundedYear}: textbooks, notebooks, magazines, brochures and commercial print on our own web & sheet-fed offset presses in ${SITE.city}.`}
  schema={[faqSchema]}
>
  <!-- HERO — full-bleed press photo, darkened so the headline leads -->
  <section class="hero hero--plant on-dark">
    <PhotoBg names={['hero-1']} alt="Offset printing press running at SGMC" overlay="plant" eager />
    <HeroVideo />
    <Roller class="hero__roller" />
    <div class="container">
      <p class="eyebrow">{SITE.legalName} · Est. {SITE.foundedYear}</p>
      <h1>
        <span class="line"><span>Printing excellence</span></span>
        <span class="line"><span><span class="proof">across generations.</span></span></span>
      </h1>
      <p class="lead" data-reveal>
        Textbooks, notebooks, magazines and commercial print, produced on our own web and sheet-fed offset presses. Plate, press and binding, all in one building.
      </p>
      <div class="btn-row" data-reveal style="--d:.1s">
        <a class="btn" href="/contact/">Get a quote <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--outline" href="#contents">See what we print</a>
      </div>
      <div class="hero__facts" data-stack>
        <div><strong>{yr}</strong><span>Established</span></div>
        <div><strong data-count="45" data-suffix="+">45+</strong><span>Product types</span></div>
        <div><strong data-count="100" data-suffix="%">100%</strong><span>In-house</span></div>
      </div>
    </div>
  </section>

  <!-- PROMISE -->
  <section class="promise" aria-label="Our promise">
    <div class="container promise__grid">
      {SITE.promise.map((p, i) => (
        <div class="promise__item"><span>0{i + 1}</span><strong>{p}</strong></div>
      ))}
    </div>
  </section>

  <!-- PRODUCTS — photo cards per category -->
  <section class="section" id="contents" aria-labelledby="contents-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>What we print</p>
          <h2 id="contents-h" style="margin-top:1rem" data-reveal>Print solutions for <span class="proof">every need.</span></h2>
        </div>
        <div style="display:grid;gap:1.2rem;justify-items:start">
          <p class="lead" data-reveal>Single-colour to full-colour, short runs to bulk, from school textbooks to labels and certificates.</p>
          <a class="link-arrow" href="/products/" data-reveal>All products <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="tiles tiles--products" data-reveal-stagger>
        {categories.map((c) => (
          <PhotoTile href={`/products/${c.slug}/`} image={`cat-${c.slug}`} title={c.cardTitle} kicker={`${c.items.length} ${c.itemNoun ?? 'products'}`} text={c.short} />
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCT RUNNING LINE -->
  <div class="marquee" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="marquee__track">
        {categories.flatMap((c) => c.items.slice(0, 2)).map((t) => <span class="marquee__item">{t}</span>)}
      </div>
    ))}
  </div>

  <PaperRun />

  <!-- THE PRESS FLOOR — services with live preview -->
  <section class="section has-texture" aria-labelledby="floor-h">
    <TextureBg name="facility-1" />
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Services</p>
          <h2 id="floor-h" style="margin-top:1rem" data-reveal>On the <span class="proof">press floor.</span></h2>
        </div>
        <div style="display:grid;gap:1.2rem;justify-items:start">
          <p class="lead" data-reveal>Every stage happens in-house, by our own team. Nothing is outsourced, so quality and dates stay in our hands.</p>
          <a class="link-arrow" href="/services/" data-reveal>All services <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="floor" data-floor>
        <ol class="floor__list" role="list" data-reveal-stagger>
          {services.map((s, i) => (
            <li data-reveal>
              <a class:list={['floor__item', { 'is-active': i === 0 }]} href={`/services/${s.slug}/`} data-floor-item={i}>
                <span class="n">0{i + 1}</span>
                <h3>{s.title}</h3>
                <Icon name="arrow" />
                <p>{s.short}</p>
              </a>
            </li>
          ))}
        </ol>
        <div class="floor__view" aria-hidden="true">
          <div class="sheet">
            <div class="floor__stack">
              {services.map((s, i) => (
                <Media name={s.slug} alt="" class={i === 0 ? 'is-active' : ''} sizes="(min-width: 1000px) 45vw, 1px" />
              ))}
            </div>
          </div>
          <div class="slug"><span data-floor-slug>{services[0].equipment.join(' · ')}</span><span class="slug__inks"><i style="background:var(--c)"></i><i style="background:var(--m)"></i><i style="background:var(--y)"></i><i style="background:var(--k)"></i></span></div>
          <template data-floor-slugs>{JSON.stringify(services.map((s) => s.equipment.join(' · ')))}</template>
        </div>
      </div>
    </div>
  </section>

  <!-- HERITAGE -->
  <section class="section section--white section--rule" aria-labelledby="about-h">
    <div class="container heritage">
      <div data-reveal>
        <div class="sheet">
          <Media name="home-about" alt="Printing press at work in the SGMC facility" word={`Since ${yr}`} />
        </div>
        <div class="slug"><span>Archive · The press hall</span><span>Est. {yr}</span></div>
      </div>
      <div style="display:grid;gap:1.4rem">
        <p class="eyebrow" data-reveal>Our story</p>
        <div class="bigyear" aria-hidden="true" data-reveal>{yr.slice(0, 2)}<span>{yr.slice(2)}</span></div>
        <h2 id="about-h" class="h3" style="font-size:clamp(1.8rem,3vw,2.4rem)" data-reveal>Putting knowledge on paper since {yr}.</h2>
        <p class="lead" data-reveal>Since {SITE.foundedYear}, {SITE.legalName} has printed books, publications and commercial work for schools, colleges, publishers and businesses.</p>
        {/* NEEDS BUSINESS CONFIRMATION: number of generations — audit C-09 wording is "Three generations of printing experience, …" once confirmed */}
        <p class="muted" data-reveal>Generations of experience, now running web and sheet-fed offset presses, CTP pre-press and in-house finishing from our own building.</p>
        {/* "100% in-house" is shown once, in the hero facts (C-09) */}
        <div class="facts" data-stack style="grid-template-columns:repeat(2,1fr)">
          <div><strong data-count="4">4</strong><span>Departments in-house</span></div>
          <div><strong data-count="6">6</strong><span>Printing services</span></div>
        </div>
        <div data-reveal><a class="link-arrow" href="/about/">Read our story <Icon name="arrow" /></a></div>
      </div>
    </div>
  </section>

  <Leadership />

  <PaperRun />

  <!-- MACHINE ROOM — spec sheet -->
  <section class="section section--dark has-texture" aria-labelledby="machines-h">
    <TextureBg name="facility-2" />
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Infrastructure</p>
          <h2 id="machines-h" style="margin-top:1rem" data-reveal>The machine <span class="proof">room.</span></h2>
        </div>
        <p class="lead" data-reveal>Our own building and our own machines, from pre-press to final finishing. Here's the spec sheet.</p>
      </div>
      <div class="machine-strip" data-reveal-stagger>
        {['facility-1', 'facility-2', 'facility-3'].map((n) => (
          <div class="sheet" style="padding:14px" data-reveal><Media name={n} alt="Machinery at the SGMC press" sizes="(min-width: 1000px) 30vw, 50vw" /></div>
        ))}
      </div>
      <CropMarks>
      <table class="spec" data-reveal>
        <thead><tr><th>Ref.</th><th>Department</th><th>Machines</th><th>Used for</th></tr></thead>
        <tbody>
          {SITE.machineGroups.map((g) => (
            <tr>
              <td class="spec__code">{groupMeta[g.group]?.code}</td>
              <td class="spec__group">{g.group}</td>
              <td><ul class="spec__machines" role="list">{g.items.map((m) => <li>{m}</li>)}</ul></td>
              <td class="spec__use">{groupMeta[g.group]?.use}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </CropMarks>
      <div class="btn-row" style="margin-top:2.5rem" data-reveal>
        <a class="btn" href="/infrastructure/">Tour the infrastructure <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- WHY SGMC -->
  <section class="section" aria-labelledby="why-h">
    <div class="container why">
      <div style="display:grid;gap:1.4rem;align-content:start">
        <p class="eyebrow" data-reveal>Why SGMC</p>
        <h2 id="why-h" data-reveal>Heritage, <span class="proof">proofed</span> every day.</h2>
        <p class="lead" data-reveal>Printing experience since {yr}, an integrated plant and a team that answers the phone. Here's what that means for your job.</p>
        <div data-reveal><a class="btn btn--ink" href="/contact/">Start a job <Icon name="arrow" class="arrow" /></a></div>
      </div>
      <div class="why__grid" data-reveal-stagger>
        {why.map((w, i) => (
          <article class="why__item" data-reveal>
            <div class="why__top"><span class="why__icon"><Icon name={w.icon} /></span><span>0{i + 1}</span></div>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS — the five steps live on /services/ (UX-06); home links to them -->
  <section class="section section--dark on-dark" aria-labelledby="process-h">
    <div class="container">
      <div class="section-head section-head--split" style="margin-bottom:0">
        <div>
          <p class="eyebrow">How a job runs</p>
          <h2 id="process-h" style="margin-top:1rem">Five signatures, <span class="proof">one book.</span></h2>
        </div>
        <div style="display:grid;gap:1.2rem;justify-items:start">
          <p class="lead">From your first message to the delivery van, one team is accountable for every stage.</p>
          <a class="link-arrow" href="/services/#process">See the five steps <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <PaperRun />

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-h">
    <div class="container">
      <div class="split" style="align-items:start">
        <div style="display:grid;gap:1.4rem">
          <p class="eyebrow" data-reveal>Questions</p>
          <h2 id="faq-h" data-reveal>Before you <span class="proof">send files.</span></h2>
          <p class="lead" data-reveal>Something else? Call {SITE.contacts[0].name} on <a href={`tel:${SITE.phoneHref}`} style="text-decoration:underline">{SITE.phone}</a>.</p>
        </div>
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <!-- QUOTE — job ticket -->
  <section class="section section--white section--rule" aria-labelledby="talk-h" id="quote">
    <div class="container contact-grid">
      <div style="display:grid;gap:1.4rem;align-content:start">
        <p class="eyebrow" data-reveal>Get a quote</p>
        <h2 id="talk-h" data-reveal>Open a <span class="proof">job ticket.</span></h2>
        <p class="lead" data-reveal>Tell us the product, quantity, size, page count and colours. We'll reply with a clear quote.</p>
        <ul class="contact-list" data-reveal-stagger>
          {SITE.contacts.map((c) => (
            <li data-reveal>
              <a class="contact-item" href={`tel:${c.phoneHref}`}>
                <span class="contact-item__icon"><Icon name="phone" /></span>
                <span><small>{c.name}</small><strong>{c.phone}</strong></span>
              </a>
            </li>
          ))}
          <li data-reveal>
            <a class="contact-item" href={whatsappLink()} target="_blank" rel="noopener">
              <span class="contact-item__icon" style="color:#1faa53"><Icon name="whatsapp" /></span>
              <span><small>WhatsApp</small><strong>Chat with us</strong></span>
            </a>
          </li>
        </ul>
      </div>
      <div data-reveal><ContactForm /></div>
    </div>
  </section>
</BaseLayout>
