---
// Home — copy as supplied by the client (2026-11-05), section by section.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import PhotoBg from '../components/PhotoBg.astro';
import PhotoTile from '../components/PhotoTile.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import PaperRun from '../components/plant/PaperRun.astro';
import Roller from '../components/plant/Roller.astro';
import TextureBg from '../components/plant/TextureBg.astro';
import CropMarks from '../components/plant/CropMarks.astro';
import HeroVideo from '../components/plant/HeroVideo.astro';
import Leadership from '../components/Leadership.astro';
import { SITE } from '../config/site';
import { services, process } from '../data/services';
import { categories } from '../data/products';
import { faqs } from '../data/faqs';

const yr = String(SITE.foundedYear);

// Section 6 — what each department is for (client copy)
const groupMeta: Record<string, { code: string; use: string }> = {
  'Web Offset Printing': { code: 'WEB-01', use: 'Designed for reel-fed production of large-volume publications.' },
  'Sheet-Fed Offset Printing': { code: 'SHT-02', use: 'Supporting colour-critical commercial printing and publication production.' },
  'Pre-Press': { code: 'PRE-03', use: 'Supporting accurate plate preparation and printing readiness.' },
  'Post-Press & Finishing': { code: 'FIN-04', use: 'Supporting the transformation of printed sheets into completed publications.' },
};

// Section 7 — why choose SGMC (client copy)
const why = [
  { icon: 'users', title: 'Generations of Printing Experience', tagline: 'Experience That Makes a Difference.', text: 'Established in 1965, our business brings decades of printing knowledge and industry experience to every customer relationship.' },
  { icon: 'press', title: 'Complete In-House Capabilities', tagline: 'One Team. One Coordinated Process.', text: 'With pre-press, printing and finishing capabilities under one roof, we maintain direct oversight of key production stages.' },
  { icon: 'palette', title: 'Dedicated Design Support', tagline: 'Your Ideas. Professionally Developed.', text: 'Our in-house design team can help develop artwork, refine existing designs and prepare files for printing.' },
  { icon: 'shield', title: 'Quality-Focused Production', tagline: 'Attention to Detail at Every Stage.', text: 'From artwork preparation to final finishing, our production approach emphasizes careful execution and consistency.' },
  { icon: 'rupee', title: 'Competitive Commercial Solutions', tagline: 'The Right Balance of Quality and Value.', text: 'We work to provide practical printing solutions and competitive pricing based on your project’s specifications and quantities.' },
  { icon: 'truck', title: 'Commitment to Delivery', tagline: 'Your Deadlines Matter to Us.', text: 'We understand the importance of production schedules and work closely with customers to plan printing and delivery requirements.' },
] as const;

const homeCategories = categories.filter((c) => c.home);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  rawTitle
  title={`${SITE.name} | Offset Printing ${SITE.city}`}
  description={`Established in ${SITE.foundedYear}: educational, publication and commercial printing with in-house pre-press, web and sheet-fed offset printing, binding and finishing in ${SITE.city}.`}
  schema={[faqSchema]}
>
  <!-- 1 · HERO -->
  <section class="hero hero--plant on-dark">
    <PhotoBg names={['hero-1']} alt="Offset printing press (illustrative image)" overlay="plant" eager />
    <HeroVideo />
    <Roller class="hero__roller" />
    <div class="container">
      <p class="eyebrow">{SITE.legalName} · Est. {SITE.foundedYear}</p>
      <h1>
        <span class="line"><span>Generations of Expertise.</span></span>
        <span class="line"><span><span class="proof">Excellence in Every Impression.</span></span></span>
      </h1>
      <p class="hero__motto" data-reveal>{SITE.motto}</p>
      <p class="lead" data-reveal>
        For generations, {SITE.legalName} has transformed ideas into professionally printed products. Combining decades of industry experience with comprehensive printing infrastructure, we deliver dependable solutions for publishers, educational institutions, businesses and organizations.
      </p>
      <p class="hero__more" data-reveal>From your first design to the final finished product, our experienced team brings precision, craftsmanship and commitment to every stage of production.</p>
      <div class="btn-row" data-reveal style="--d:.1s">
        <a class="btn" href="/contact/">Discuss Your Printing Project <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--outline" href="/services/">Explore Our Capabilities</a>
      </div>
      <ul class="hero__highlights" role="list" data-stack>
        <li><Icon name="check" /> Established in {yr}</li>
        <li><Icon name="check" /> Generations of Printing Expertise</li>
        <li><Icon name="check" /> Integrated In-House Production</li>
      </ul>
    </div>
  </section>

  <!-- PROMISE -->
  <section class="promise" aria-label="Our commitment">
    <div class="container promise__grid">
      {SITE.promise.map((p, i) => (
        <div class="promise__item"><span>0{i + 1}</span><strong>{p}</strong></div>
      ))}
    </div>
  </section>

  <!-- 2 · OUR PRINTING SOLUTIONS -->
  <section class="section" id="solutions" aria-labelledby="solutions-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Our printing solutions</p>
          <h2 id="solutions-h" style="margin-top:1rem" data-reveal>Your Ideas Deserve an <span class="proof">Exceptional Finish.</span></h2>
          <p class="section-sub" data-reveal>Comprehensive Printing Solutions. One Trusted Partner.</p>
        </div>
        <div style="display:grid;gap:1rem;justify-items:start">
          <p class="lead" data-reveal>Every project begins with a purpose. Whether you’re publishing educational materials, promoting your business or producing commercial publications, we help bring your requirements to life through professional printing solutions.</p>
          <p data-reveal>From single-colour printing to sophisticated multi-colour production, our capabilities support a wide range of printing needs.</p>
        </div>
      </div>
      <div class="tiles tiles--products" data-reveal-stagger>
        {homeCategories.map((c) => (
          <PhotoTile href={`/products/${c.slug}/`} image={`cat-${c.slug}`} title={c.home!.title} kicker={c.home!.tagline} text={c.home!.text} />
        ))}
        <PhotoTile href="/contact/" image="cat-printing-options" title="Custom Printing Requirements" kicker="Tell us what you need." text="Have a specific format, quantity or finishing requirement? Speak with our team about the available options." />
      </div>
      <div class="btn-row" style="margin-top:2.5rem" data-reveal>
        <a class="btn btn--ink" href="/products/">Discover All Printing Solutions <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- PRODUCT RUNNING LINE -->
  <div class="marquee" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="marquee__track">
        {categories.flatMap((c) => c.items.slice(0, 2)).map((t) => <span class="marquee__item">{t}</span>)}
      </div>
    ))}
  </div>

  <PaperRun />

  <!-- 3 · OUR SERVICES — with live preview -->
  <section class="section has-texture" aria-labelledby="floor-h">
    <TextureBg name="facility-1" />
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Our services</p>
          <h2 id="floor-h" style="margin-top:1rem" data-reveal>From Concept to Completion. <span class="proof">Excellence at Every Stage.</span></h2>
          <p class="section-sub" data-reveal>One Facility. Multiple Capabilities. Complete Production Control.</p>
        </div>
        <div style="display:grid;gap:1rem;justify-items:start">
          <p class="lead" data-reveal>Exceptional printing requires more than machinery. It requires coordination, experience and attention to detail.</p>
          <p data-reveal>Our integrated production infrastructure brings together pre-press preparation, offset printing, binding and finishing, helping us maintain consistency throughout the printing process.</p>
        </div>
      </div>
      <div class="floor" data-floor>
        <ol class="floor__list" role="list" data-reveal-stagger>
          {services.map((s, i) => (
            <li data-reveal>
              <a class:list={['floor__item', { 'is-active': i === 0 }]} href={`/services/${s.slug}/`} data-floor-item={i}>
                <span class="n">0{i + 1}</span>
                <h3>{s.title}</h3>
                <Icon name="arrow" />
                <p><strong>{s.tagline}</strong> {s.pitch}</p>
              </a>
            </li>
          ))}
        </ol>
        <div class="floor__view" aria-hidden="true">
          <div class="sheet">
            <div class="floor__stack">
              {services.map((s, i) => (
                <Media name={s.slug} alt="" class={i === 0 ? 'is-active' : ''} sizes="(min-width: 1000px) 45vw, 1px" />
              ))}
            </div>
          </div>
          <div class="slug"><span data-floor-slug>{services[0].equipment.join(' · ')}</span><span class="slug__inks"><i style="background:var(--c)"></i><i style="background:var(--m)"></i><i style="background:var(--y)"></i><i style="background:var(--k)"></i></span></div>
          <template data-floor-slugs>{JSON.stringify(services.map((s) => s.equipment.join(' · ')))}</template>
        </div>
      </div>
      <div class="btn-row" style="margin-top:2.5rem" data-reveal>
        <a class="btn btn--ink" href="/services/">Explore Our Services <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- 4 · OUR STORY -->
  <section class="section section--white section--rule" aria-labelledby="about-h">
    <div class="container heritage">
      <div data-reveal>
        <div class="sheet">
          <Media name="home-about" alt="Vintage offset printing press (illustrative image)" word={`Since ${yr}`} />
        </div>
        <div class="slug"><span>Illustrative image</span><span>Est. {yr}</span></div>
      </div>
      <div style="display:grid;gap:1.2rem">
        <p class="eyebrow" data-reveal>Our story</p>
        <div class="bigyear" aria-hidden="true" data-reveal>{yr.slice(0, 2)}<span>{yr.slice(2)}</span></div>
        <h2 id="about-h" class="h3" style="font-size:clamp(1.8rem,3vw,2.4rem)" data-reveal>A Legacy Built on Paper. A Reputation Built on Trust.</h2>
        <p class="section-sub" style="margin-top:0" data-reveal>{SITE.legacyLine}</p>
        <p class="lead" data-reveal>Our story began in {yr} with a commitment to quality printing, dependable service and lasting customer relationships.</p>
        <p data-reveal>Today, {SITE.legalName} continues that legacy as a family-led printing business, combining generations of industry knowledge with integrated production capabilities.</p>
        <p data-reveal>From educational publications to commercial printing, we have continued to develop our services while preserving the values that define our business.</p>
        <h3 data-reveal style="margin-top:.6rem">Our Heritage. Your Confidence.</h3>
        <p class="muted" data-reveal>For us, printing is more than producing ink on paper. It is about understanding our customers’ requirements, respecting their deadlines and delivering work that reflects their expectations.</p>
        <div data-reveal><a class="link-arrow" href="/about/">Discover Our Journey <Icon name="arrow" /></a></div>
      </div>
    </div>
  </section>

  <!-- 5 · LEADERSHIP -->
  <Leadership link={{ label: 'Learn About Our Company', href: '/about/' }} />

  <PaperRun />

  <!-- 6 · INFRASTRUCTURE — spec sheet -->
  <section class="section section--dark has-texture" aria-labelledby="machines-h">
    <TextureBg name="facility-2" />
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Infrastructure</p>
          <h2 id="machines-h" style="margin-top:1rem" data-reveal>The Power Behind Every <span class="proof">Perfectly Planned Print.</span></h2>
          <p class="section-sub" data-reveal>Advanced Capabilities. Integrated Infrastructure. Experienced Hands.</p>
        </div>
        <div style="display:grid;gap:1rem">
          <p class="lead" data-reveal>Great printing depends on the right combination of technology, expertise and production discipline.</p>
          <p data-reveal>Our integrated printing facility brings together web offset presses, sheet-fed offset machinery, computer-to-plate preparation and finishing equipment. This enables us to coordinate multiple production stages while maintaining direct oversight of the printing process.</p>
        </div>
      </div>
      <CropMarks>
      <table class="spec" data-reveal>
        <thead><tr><th>Ref.</th><th>Department</th><th>Equipment</th><th>Used for</th></tr></thead>
        <tbody>
          {SITE.machineGroups.map((g) => (
            <tr>
              <td class="spec__code">{groupMeta[g.group]?.code}</td>
              <td class="spec__group">{g.group}</td>
              <td><ul class="spec__machines" role="list">{g.items.map((m) => <li>{m}</li>)}</ul></td>
              <td class="spec__use">{groupMeta[g.group]?.use}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </CropMarks>
      <div class="btn-row" style="margin-top:2.5rem" data-reveal>
        <a class="btn" href="/infrastructure/">Explore Our Printing Infrastructure <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- 7 · WHY CHOOSE SGMC -->
  <section class="section" aria-labelledby="why-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Why choose SGMC?</p>
          <h2 id="why-h" style="margin-top:1rem" data-reveal>Experience You Can Trust. <span class="proof">Capabilities You Can Count On.</span></h2>
        </div>
        <div style="display:grid;gap:1rem;justify-items:start">
          <p class="lead" data-reveal>Choosing the right printing partner means finding a company that understands your requirements and has the resources to deliver.</p>
          <p data-reveal>At SGMC, our heritage, experienced workforce and integrated facilities come together to support your printing needs.</p>
        </div>
      </div>
      <div class="why__grid why__grid--6" data-reveal-stagger>
        {why.map((w, i) => (
          <article class="why__item" data-reveal>
            <div class="why__top"><span class="why__icon"><Icon name={w.icon} /></span><span>0{i + 1}</span></div>
            <h3>{w.title}</h3>
            <p class="why__tagline">{w.tagline}</p>
            <p>{w.text}</p>
          </article>
        ))}
      </div>
      <div class="btn-row" style="margin-top:2.5rem" data-reveal>
        <a class="btn btn--ink" href="/contact/">Partner With SGMC <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- 8 · HOW YOUR PROJECT COMES TO LIFE -->
  <section class="section section--dark on-dark" aria-labelledby="process-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">How your project comes to life</p>
          <h2 id="process-h" style="margin-top:1rem">From Your First Idea to the <span class="proof">Final Printed Product.</span></h2>
        </div>
        <p class="section-sub" style="align-self:end">A Coordinated Process. A Team That Understands Printing.</p>
      </div>
      <div class="grid" data-reveal-stagger style="grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr))">
        {process.map((p, i) => (
          <article class="process-step" data-reveal>
            <span class="process-step__n">Step 0{i + 1}</span>
            <h3 style="font-size:1.2rem">{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <div class="btn-row" style="margin-top:2.5rem">
        <a class="btn" href="/contact/">Start Your Printing Project <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <PaperRun />

  <!-- 9 · FREQUENTLY ASKED QUESTIONS -->
  <section class="section" aria-labelledby="faq-h">
    <div class="container">
      <div class="split" style="align-items:start">
        <div style="display:grid;gap:1.2rem">
          <p class="eyebrow" data-reveal>Frequently asked questions</p>
          <h2 id="faq-h" data-reveal>Your Questions. <span class="proof">Our Expertise.</span></h2>
          <p class="lead" data-reveal>Everything You Need to Know Before Your Next Print Project.</p>
          <p data-reveal>Something else? Call {SITE.contacts[0].name} on <a href={`tel:${SITE.phoneHref}`} style="text-decoration:underline">{SITE.phone}</a>.</p>
        </div>
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <!-- 10 · FINAL CALL TO ACTION -->
  <CTA />
</BaseLayout>
