---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import PhotoBg from '../components/PhotoBg.astro';
import PhotoTile from '../components/PhotoTile.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, whatsappLink } from '../config/site';
import { services, process } from '../data/services';
import { categories } from '../data/products';
import { faqs } from '../data/faqs';

const yr = String(SITE.foundedYear);

// Client-supplied strengths (docs/client-brief.md §6)
const why = [
  { icon: 'palette', title: 'In-house design team', text: 'Experienced designers for complete artwork development and pre-press support.' },
  { icon: 'press', title: 'Modern machinery', text: 'Multi-colour offset, web printing, CTP and integrated finishing in one building.' },
  { icon: 'clock', title: 'Dependable delivery', text: 'A firm commitment to agreed production schedules and delivery dates.' },
  { icon: 'shield', title: 'Quality at a fair price', text: 'Consistent print quality and competitive pricing, especially for bulk orders.' },
] as const;

const ticker = [...SITE.promise, ...SITE.strengths];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  rawTitle
  heroDark
  title={`${SITE.name} — Book, Textbook & Offset Printing Press since ${SITE.foundedYear} | ${SITE.city}`}
  description={`${SITE.legalName}, printing since ${SITE.foundedYear}: textbooks, notebooks, magazines, catalogues, brochures and commercial printing on our own web & sheet-fed offset presses in ${SITE.city}.`}
  schema={[faqSchema]}
>
  <!-- HERO — full-bleed press photos -->
  <section class="hero hero--full on-dark" data-hero-slides>
    <PhotoBg names={['hero-1', 'hero-2', 'hero-3', 'hero-4']} alt="Offset printing press running at SGMC" overlay="strong" eager />
    <div class="container">
      <p class="eyebrow">{SITE.legalName} · Est. {yr}</p>
      <h1>
        <span class="line"><span>Built on presses.</span></span>
        <span class="line"><span><em>Trusted since {yr}.</em></span></span>
      </h1>
      <p class="lead" data-reveal>
        Textbooks, notebooks, magazines and commercial print on our own web and sheet-fed offset presses. Plate, press and binding, all under one roof.
      </p>
      <div class="btn-row" data-reveal style="--d:.1s">
        <a class="btn" href="/contact/">Get a quote <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--outline" href={`tel:${SITE.phoneHref}`}><Icon name="phone" /> {SITE.phone}</a>
      </div>
    </div>
    <div class="hero__bar">
      <div class="container">
        {SITE.stats.map((s) => (
          <div class="stat">
            <strong {...(s.label === 'Printing since' ? {} : { 'data-count': s.value, 'data-suffix': s.suffix })}>{s.value}{s.suffix}</strong>
            <span>{s.label}</span>
          </div>
        ))}
        <span class="hero__dots" data-slide-dots aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- PROMISE TICKER -->
  <div class="marquee ticker" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="marquee__track">{ticker.map((t) => <span class="marquee__item">{t}</span>)}</div>
    ))}
  </div>

  <!-- SERVICES -->
  <section class="section" aria-labelledby="services-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Services</p>
          <h2 id="services-h" style="margin-top:1rem" data-reveal>Everything <em>in-house.</em></h2>
        </div>
        <div style="display:grid;gap:1.2rem;justify-items:start">
          <p class="lead" data-reveal>Pre-press, printing and finishing by our own team. Nothing is outsourced, so quality and dates stay in our hands.</p>
          <a class="link-arrow" href="/services/" data-reveal>All services <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="tiles" data-reveal-stagger>
        {services.map((s) => (
          <PhotoTile href={`/services/${s.slug}/`} image={`bg-${s.slug}`} title={s.title} kicker={s.kicker} text={s.short} />
        ))}
      </div>
    </div>
  </section>

  <!-- MACHINES — press band -->
  <section class="press-band on-dark" aria-labelledby="machines-h">
    <PhotoBg names={['band-press']} alt="" overlay="strong" />
    <div class="container press-band__inner">
      <p class="eyebrow" data-reveal>Infrastructure</p>
      <h2 id="machines-h" data-reveal>Our own building. <em>Our own machines.</em></h2>
      <p class="lead" data-reveal>From CTP plates to perfect binding, every machine your job touches is ours.</p>
      <div class="machine-groups" style="margin-top:2rem" data-reveal-stagger>
        {SITE.machineGroups.map((g, i) => (
          <div class="machine-group" data-reveal>
            <span class="machine-group__n">0{i + 1}</span>
            <h3>{g.group}</h3>
            <ul>{g.items.map((m) => <li>{m}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="btn-row" style="margin-top:1.5rem" data-reveal>
        <a class="btn" href="/infrastructure/">Tour the infrastructure <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="section" aria-labelledby="products-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>What we print</p>
          <h2 id="products-h" style="margin-top:1rem" data-reveal>Single colour to <em>full colour.</em></h2>
        </div>
        <p class="lead" data-reveal>Short runs to bulk orders, from school textbooks to labels and certificates.</p>
      </div>
      <div class="tiles tiles--products" data-reveal-stagger>
        {categories.map((c) => (
          <PhotoTile href={`/products/${c.slug}/`} image={`cat-${c.slug}`} title={c.title.replace(/ Printing$/, '')} kicker={`${c.items.length} products`} text={c.short} />
        ))}
      </div>
    </div>
  </section>

  <!-- HERITAGE -->
  <section class="section section--white" aria-labelledby="about-h">
    <div class="container split">
      <Media name="home-about" alt="Printing press at work in the SGMC facility" word={`Since ${yr}`} parallax />
      <div style="display:grid;gap:1.4rem">
        <p class="eyebrow" data-reveal>Our story</p>
        <div class="bigyear" aria-hidden="true" data-reveal>{yr.slice(0, 2)}<span>{yr.slice(2)}</span></div>
        <h2 id="about-h" data-reveal>Putting knowledge on paper.</h2>
        <p class="lead" data-reveal>Since {yr}, {SITE.legalName} has printed books, publications and commercial work for schools, colleges, publishers and businesses.</p>
        <div data-reveal><a class="link-arrow" href="/about/">Read our story <Icon name="arrow" /></a></div>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="section" aria-labelledby="why-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow" data-reveal>Why SGMC</p>
        <h2 id="why-h" data-reveal>{SITE.promise.join(' · ')}</h2>
      </div>
      <div class="grid grid-4" data-reveal-stagger>
        {why.map((w) => (
          <article class="why__item" data-reveal>
            <span class="why__icon"><Icon name={w.icon} /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="process section--dark on-dark" aria-labelledby="process-h">
    <div class="process__pin section">
      <div class="container">
        <div class="section-head section-head--split">
          <div>
            <p class="eyebrow">How a job runs</p>
            <h2 id="process-h" style="margin-top:1rem">Five steps, <em>one team.</em></h2>
          </div>
          <p class="lead">From your first message to the delivery van, one team is accountable for every stage.</p>
        </div>
        <div class="process__track">
          {process.map((p, i) => (
            <article class="process-step">
              <span class="process-step__n">Step 0{i + 1} / 0{process.length}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-h">
    <div class="container split" style="align-items:start">
      <div style="display:grid;gap:1.4rem">
        <p class="eyebrow" data-reveal>Questions</p>
        <h2 id="faq-h" data-reveal>Good to <em>know.</em></h2>
        <p class="lead" data-reveal>Something else? Call {SITE.contacts[0].name} on <a href={`tel:${SITE.phoneHref}`} style="text-decoration:underline">{SITE.phone}</a>.</p>
      </div>
      <FAQ items={faqs} />
    </div>
  </section>

  <!-- QUOTE -->
  <section class="section section--white" aria-labelledby="talk-h" id="quote">
    <div class="container contact-grid">
      <div style="display:grid;gap:1.4rem;align-content:start">
        <p class="eyebrow" data-reveal>Get a quote</p>
        <h2 id="talk-h" data-reveal>Let's <em>talk print.</em></h2>
        <p class="lead" data-reveal>Tell us the product, quantity, size, page count and colours. We'll reply with a clear quote.</p>
        <ul class="contact-list" data-reveal-stagger>
          {SITE.contacts.map((c) => (
            <li data-reveal>
              <a class="contact-item" href={`tel:${c.phoneHref}`}>
                <span class="contact-item__icon"><Icon name="phone" /></span>
                <span><small>{c.name}</small><strong>{c.phone}</strong></span>
              </a>
            </li>
          ))}
          <li data-reveal>
            <a class="contact-item" href={whatsappLink()} target="_blank" rel="noopener">
              <span class="contact-item__icon" style="color:#1faa53"><Icon name="whatsapp" /></span>
              <span><small>WhatsApp</small><strong>Chat with us</strong></span>
            </a>
          </li>
        </ul>
      </div>
      <div data-reveal><ContactForm /></div>
    </div>
  </section>
</BaseLayout>
