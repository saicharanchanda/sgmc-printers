---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MachineCard from '../components/MachineCard.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import { SITE } from '../config/site';

const crumbs = [{ name: 'Infrastructure', href: '/infrastructure/' }];

// Client copy (2026-11-05) for each department
const groupInfo: Record<string, { title: string; code: string; tagline: string; text: string; href: string; link: string }> = {
  'Web Offset Printing': {
    title: 'Web Offset Printing',
    code: 'WEB',
    tagline: 'High-Volume Printing. Consistent Production.',
    text: 'Our reel-fed web offset presses support large-scale production of textbooks, notebooks, magazines and periodicals.',
    href: '/services/web-offset-printing/',
    link: 'See web offset printing',
  },
  'Sheet-Fed Offset Printing': {
    title: 'Sheet-Fed Offset Printing',
    code: 'SHT',
    tagline: 'Precision Printing for Demanding Applications.',
    text: 'Our sheet-fed offset presses support book covers, brochures, catalogues, posters, annual reports and other commercial printing requirements.',
    href: '/services/sheet-fed-offset-printing/',
    link: 'See sheet-fed printing',
  },
  'Pre-Press': {
    title: 'Pre-Press Facilities',
    code: 'PRE',
    tagline: 'Every Great Print Starts With the Right Preparation.',
    text: 'Our computer-to-plate system supports the preparation of accurate printing plates, helping establish consistency before production begins.',
    href: '/services/prepress/',
    link: 'See pre-press & CTP',
  },
  'Post-Press & Finishing': {
    title: 'Post-Press & Finishing',
    code: 'FIN',
    tagline: 'The Finishing Touch That Completes Every Project.',
    text: 'Printing is only one part of the process. Our finishing facilities support the conversion of printed sheets into complete books, booklets and publications.',
    href: '/services/binding-finishing/',
    link: 'See binding & finishing',
  },
};

const capabilities = [
  'School and College Textbooks',
  'Educational and Academic Publications',
  'Magazines and Periodicals',
  'Brochures and Flyers',
  'Single-Colour and Multi-Colour Printing',
  'Commercial and Bulk Printing',
];

const icons = ['shield', 'press', 'box', 'check'] as const;
---
<BaseLayout
  heroDark
  title={`Infrastructure — Offset Presses, CTP & Binding`}
  description={`${SITE.legalName} operates from its own building with Komori and Orient web offset presses, Komori sheet-fed offset presses (including the Lithrone L37), CTP pre-press, folding, perfect binding and stitching.`}
  breadcrumbs={crumbs}
>
  <PageHero
    bg={['band-press']}
    bgAlt="Printing facility floor (illustrative image)"
    eyebrow="Machinery & infrastructure"
    lines={['Built for Production.', 'Engineered for Precision.']}
    sub="The Infrastructure Behind Our Printing Expertise."
    lead="At SGMC, our production capabilities are supported by an integrated range of printing and finishing equipment."
    more="From high-volume web printing to colour-sensitive sheet-fed production, our machinery enables us to serve diverse customer requirements."
    crumbs={crumbs}
  />

  <!-- Strengths -->
  <section class="section section--tight section--white" aria-label="Our strengths">
    <div class="container">
      <div class="strengths" data-reveal-stagger>
        {SITE.strengths.map((s, i) => (
          <div class="strength" data-reveal>
            <span class="feature__icon"><Icon name={icons[i]} /></span>
            <strong>{s}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Machinery groups — each over its own machine photo -->
  <section class="section" aria-labelledby="mach-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Machinery & equipment</p>
        <h2 id="mach-h" data-reveal>Our machines</h2>
        {/* Machine names as listed by the client. NEEDS BUSINESS CONFIRMATION: exact manufacturer/model,
            quantity and specifications per machine, and a real photo of each (SITE.machinePhotos). */}
      </div>
      <div class="machine-depts">
        {SITE.machineGroups.map((g, i) => {
          const info = groupInfo[g.group];
          return (
            <article class="machine-dept" id={info.code.toLowerCase()}>
              <header class="machine-dept__head">
                <span class="machine-dept__n">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h2 class="h2" data-reveal>{info.title}</h2>
                  <p class="section-sub" style="margin-top:.4rem" data-reveal>{info.tagline}</p>
                  <p class="lead" data-reveal>{info.text}</p>
                  <a class="link-arrow" href={info.href} data-reveal>{info.link} <Icon name="arrow" /></a>
                  <p class="eyebrow" style="margin-top:1.6rem" data-reveal>Our equipment</p>
                </div>
              </header>
              <div class="machine-grid" data-reveal-stagger>
                {g.items.map((m, j) => (
                  <MachineCard
                    name={m}
                    photo={SITE.machinePhotos[m]}
                    dept={info.title}
                    code={`${info.code}.${j + 1}`}
                  />
                ))}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section section--white" aria-labelledby="cap-h">
    <div class="container split">
      <Media name="facility-3" alt="Printed sheets coming off an offset press (illustrative image)" word="Capabilities" parallax />
      <div style="display:grid;gap:1.4rem">
        <p class="eyebrow" data-reveal>Our printing capabilities</p>
        <h2 id="cap-h" data-reveal>We cater to a wide range of printing requirements.</h2>
        <ul class="checklist" data-reveal>{capabilities.map((c) => <li>{c}</li>)}</ul>
        <p class="muted" data-reveal>With our comprehensive machinery and in-house production capabilities, we deliver quality printing and finishing solutions — all under one roof.</p>
        <div data-reveal><a class="btn" href="/products/">See all products <Icon name="arrow" class="arrow" /></a></div>
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Production"
    title="The Right Equipment. The Right Expertise. The Right Printing Partner."
    sub=""
    text="Discover how our integrated production capabilities can support your next project."
    primary={{ label: 'Discuss Your Production Requirements', href: '/contact/' }}
    secondary={null}
  />
</BaseLayout>
