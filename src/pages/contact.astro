---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, whatsappLink } from '../config/site';

const crumbs = [{ name: 'Contact', href: '/contact/' }];
const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: `${SITE.url}/contact/`,
  mainEntity: { '@id': `${SITE.url}/#business` },
};
---
<BaseLayout
  heroDark
  title={`Contact Us — Printing Quote in ${SITE.city}`}
  description={`Contact ${SITE.legalName}, ${SITE.city}. Call ${SITE.contacts[0].name} ${SITE.contacts[0].phone} or ${SITE.contacts[1].name} ${SITE.contacts[1].phone}, or send your printing requirements for a quotation.`}
  breadcrumbs={crumbs}
  schema={[contactSchema]}
>
  <PageHero
    bg={['bg-contact']}
    bgAlt="Offset printing press (illustrative image)"
    eyebrow="Contact us"
    lines={['Let’s Create Something', 'Exceptional Together.']}
    sub="Your Printing Requirements. Our Expertise."
    lead="Have a project in mind? Whether you’re planning a publication, preparing commercial printing materials or exploring a long-term printing partnership, we’d be pleased to discuss your requirements."
    crumbs={crumbs}
  />

  <section class="section" style="padding-top:1rem">
    <div class="container contact-grid">
      <div style="display:grid;gap:1.4rem;align-content:start">
      <h2 class="h3" data-reveal>Speak Directly With Our Team</h2>
      <ul class="contact-list" data-reveal-stagger>
        {SITE.contacts.map((c) => (
          <li data-reveal>
            <a class="contact-item" href={`tel:${c.phoneHref}`}>
              <span class="contact-item__icon"><Icon name="phone" /></span>
              <span><small>{c.name}</small><strong>{c.phone}</strong></span>
            </a>
          </li>
        ))}
        <li data-reveal>
          <a class="contact-item" href={whatsappLink()} target="_blank" rel="noopener">
            <span class="contact-item__icon" style="background:#e3f8eb;color:#1faa53"><Icon name="whatsapp" /></span>
            <span><small>WhatsApp</small><strong>Chat with us instantly</strong></span>
          </a>
        </li>
        <li data-reveal>
          <a class="contact-item" href={`mailto:${SITE.email}`}>
            <span class="contact-item__icon"><Icon name="mail" /></span>
            <span><small>Email</small><strong>{SITE.email}</strong></span>
          </a>
        </li>
        {SITE.offices.map((o) => (
          <li data-reveal>
            <a class="contact-item" href={o.map} target="_blank" rel="noopener">
              <span class="contact-item__icon"><Icon name="pin" /></span>
              <span>
                <small>{o.label}</small>
                <address style="font-style:normal">{o.lines.map((l) => <span style="display:block">{l}</span>)}</address>
              </span>
            </a>
          </li>
        ))}
        <li data-reveal>
          <div class="contact-item">
            <span class="contact-item__icon"><Icon name="clock" /></span>
            <span><small>Business hours</small>{SITE.hours.map((h) => <span style="display:block"><strong>{h.days}:</strong> {h.time}</span>)}</span>
          </div>
        </li>
      </ul>
      </div>

      <div id="enquiry" data-reveal><ContactForm /></div>
    </div>
  </section>

  <section class="section" style="padding-top:0" aria-label="Map">
    <div class="container">
      <div class="map" data-reveal>
        <iframe
          src={SITE.mapEmbed}
          title={`Map showing ${SITE.legalName} location`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="closing-h">
    <div class="container" style="text-align:center;display:grid;gap:1rem;justify-items:center">
      <h2 id="closing-h" data-reveal>Your Next Great Print Starts With a <span class="proof">Conversation.</span></h2>
      <p class="lead" data-reveal style="margin-inline:auto">Let’s Discuss Your Project.</p>
      <div class="btn-row" style="justify-content:center" data-reveal>
        <a class="btn" href="#enquiry">Send Your Requirements <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> Contact Us on WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>
